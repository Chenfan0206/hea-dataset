            },
            "Process_Info": {
                "Process_Category": "CVI-PIP hybrid method",
                "Process_Text": {
                    "original": "Unidirectional SiCf/SiC composites were fabricated by CVI−PIP hybrid procedure. Cansas 3303 SiC fiber was used for the fabrication of UD SiC preform. BCl3−NH3−H2−Ar systems were used for the deposition of boron nitride (BN) interphases on the SiC fiber at 650 °C for 20 h. The CVI−SiC matrix then was deposited on the BN interphase at about 1000 °C using methyltrichlorosilane (MTS) as the precursor, H2 as the reducing gas, and Ar as the carrier gas for 60 h. Liquid polycarbosilane (PCS) was pyrolyzed at 1100 °C for 1 h to further densify the composites. The PIP procedure was repeated 11 cycles until the weight gain of the composites was less than 1%.",
                    "simplified": "BN interphase deposited at 650 °C for 20 h; CVI SiC deposited at ~1000 °C for 60 h; PIP pyrolysis at 1100 °C for 1 h, 11 cycles densification"
                },
                "Equipment": null,
                "Key_Params": {
                    "BN_Deposition_Temperature_K": "923.15",
                    "BN_Deposition_Time_h": 20,
                    "CVI_SiC_Deposition_Temperature_K": "1273.15",
                    "CVI_SiC_Deposition_Time_h": 60,
                    "PIP_Pyrolysis_Temperature_K": "1373.15",
                    "PIP_Pyrolysis_Time_h": 1,
                    "PIP_Cycles": 11,
