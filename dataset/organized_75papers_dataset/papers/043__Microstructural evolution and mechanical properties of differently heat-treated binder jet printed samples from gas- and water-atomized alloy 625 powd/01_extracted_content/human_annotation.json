      "Process_Info": {
        "Process_Category": "Binder Jet Printing + Sintering",
        "Process_Text": {
          "original": "M-Flex ExOne binder jet printer was used. After printing, parts were cured at 175°C and then sintered in an alumina powder bed under vacuum: heating at 5°C/min to 600°C, 3.2°C/min to 1000°C, 2.8°C/min to the holding temperature 1285°C for 4 h, then cooling at 1°C/min to 1200°C, 3.1°C/min to 500°C and finally cooling to RT.",
          "simplified": "Binder Jet Printing; Curing (175°C); Vacuum Sintering (1285°C, 4h, Alumina bed)."
        },
        "Key_Params": {
          "Curing_Temperature_K": 448.15,
          "Sintering_Temperature_K": 1558.15,
          "Sintering_Time_h": 4.0,
          "Protective_Atmosphere": "Vacuum"
        }
      },
      "Microstructure_Info": {
        "Main_Phase": "Gamma (γ)",
        "Relative_Density_pct": 99.2,
        "Grain_Size_avg_um": 89.0,
        "Microstructure_Text": {
          "original": "GA samples fully densified, showed no depletion zones and formed small amounts of fine precipitates. Grain sizes of GA samples at their highest density were 89±21 μm.",
          "simplified": "Fully densified (99.2%), no depletion zones, fine precipitates."
